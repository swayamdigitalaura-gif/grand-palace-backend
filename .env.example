# Paste your Neon connection string here (from neon.tech dashboard)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string for signing admin login sessions
JWT_SECRET="change-this-to-a-long-random-string"

# The frontend URL allowed to call this API (your TanStack Start site)
FRONTEND_URL="http://localhost:3000"

PORT=4000

# Used once by `npm run seed` to create the first admin login
ADMIN_EMAIL="admin@thegrandpalace.com.au"
ADMIN_PASSWORD="changeme123"
